{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3c3aa49e-85e4-4799-a90e-954abeb99bd7","database_name": "web-app-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bbbb3eb0143e482e9b5b8fb0670b4c59" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
